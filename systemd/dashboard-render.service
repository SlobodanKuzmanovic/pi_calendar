# NOTE: paths below assume the Pi user account is named "calendar".
# If you used a different username during setup (Raspberry Pi Imager no
# longer defaults to "pi"), replace /home/calendar/ with your own home dir.
[Unit]
Description=Render the Pi Calendar dashboard image
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/calendar/pi_calendar
ExecStart=/usr/bin/python3 /home/calendar/pi_calendar/dashboard/main.py
